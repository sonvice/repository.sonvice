<?xml version="1.0" encoding="utf-8"?>
<addons>
    <addon id="plugin.video.stremio4kodi" name="Stremio for Kodi" version="3.6.3" provider-name="stremio4kodi">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
        
            <import addon="xbmc.addon" version="12.0.0"/>
            
        
            <import addon="script.module.requests" version="2.19.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="default.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.service" library="service.py" start="startup"/>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="en">Stremio addons on Kodi — Spanish-first streaming</summary>
            
        
            <summary lang="es">Stremio en Kodi — Catálogos TMDB y Búsqueda EN/ES</summary>
            
        
            <description lang="en">Stream movies and series from Stremio addons on Kodi. v3.3.0: Direct TMDB integration (Trending, Popular, Now Playing, Top Rated, Top 100, Genres) with seamless EN/ES search and DHT/Real-Debrid stream resolution.</description>
            
        
            <description lang="es">Películas y series desde addons de Stremio y TMDB en Kodi. v3.3.0: Integración directa de TMDB (Tendencias, Popular, En cartelera, Mejor puntuadas, Top 100 últimos años, Géneros) y búsqueda bilingüe EN/ES sin fallos.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>resources/media/icon.png</icon>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="repository.sonvice" name="Sonvice Repository" version="1.0.10" provider-name="sonvice">
        
    
        <requires>
            
        
            <import addon="xbmc.addon" version="12.0.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Repositorio de Addons de Sonvice</summary>
            
        
            <summary lang="en">Sonvice Addons Repository</summary>
            
        
            <description lang="es">Instala y actualiza automáticamente Stremio for Kodi y otros addons creados por Sonvice.</description>
            
        
            <description lang="en">Automatically install and update Stremio for Kodi and other addons created by Sonvice.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
        
            </assets>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.repository" name="Sonvice Repository">
            
        
            <dir>
                
            
                <info compressed="false">https://cdn.jsdelivr.net/gh/sonvice/repository.sonvice@main/repo/addons.xml</info>
                
            
                <checksum>https://cdn.jsdelivr.net/gh/sonvice/repository.sonvice@main/repo/addons.xml.md5</checksum>
                
            
                <datadir zip="true">https://cdn.jsdelivr.net/gh/sonvice/repository.sonvice@main/repo/</datadir>
                
        
            </dir>
            
    
        </extension>
        

    </addon>
</addons>
