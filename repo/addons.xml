<?xml version="1.0" encoding="utf-8"?>
<addons>
    <addon id="plugin.video.stremio4kodi" name="Stremio for Kodi" version="3.7.4" provider-name="stremio4kodi">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
        
            <import addon="xbmc.addon" version="12.0.0"/>
            
        
            <import addon="script.module.requests" version="2.19.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="default.py">
            
        
            <provides>video</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.service" library="service.py" start="startup"/>
        
    
        <extension point="xbmc.subtitle.module" library="subtitle_service.py"/>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="en">Stremio addons on Kodi — Integrated OpenSubtitles &amp; Spanish-first streaming</summary>
            
        
            <summary lang="es">Stremio en Kodi — OpenSubtitles Integrado y Catálogos TMDB</summary>
            
        
            <description lang="en">Stream movies and series from Stremio addons on Kodi with built-in OpenSubtitles v3 (zero-configuration, free subtitle downloads without account or API key), TMDB integration, and Torrent/Real-Debrid resolution.</description>
            
        
            <description lang="es">Películas y series desde addons de Stremio en Kodi con OpenSubtitles v3 integrado (sin cuentas, sin registro y gratis directamente en el reproductor de Kodi), integración TMDB y resolución Torrent/Debrid.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>resources/media/icon.png</icon>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="script.program.vpncontrol" name="Control VPN (CoreELEC)" version="1.0.0" provider-name="Wilson">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.python.pluginsource" library="default.py">
            
        
            <provides>executable</provides>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Conmutador rápido de VPN para CoreELEC</summary>
            
        
            <description lang="es">Permite conectar, desconectar y alternar entre Surfshark y Cloudflare WARP con 1 solo clic desde el mando a distancia.</description>
            
        
            <platform>all</platform>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
    <addon id="repository.sonvice" name="Sonvice Repository" version="1.0.10" provider-name="sonvice">
        
    
        <requires>
            
        
            <import addon="xbmc.addon" version="12.0.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="es">Repositorio de Addons de Sonvice</summary>
            
        
            <summary lang="en">Sonvice Addons Repository</summary>
            
        
            <description lang="es">Instala y actualiza automáticamente Stremio for Kodi y otros addons creados por Sonvice.</description>
            
        
            <description lang="en">Automatically install and update Stremio for Kodi and other addons created by Sonvice.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
        
            </assets>
            
    
        </extension>
        
    
        <extension point="xbmc.addon.repository" name="Sonvice Repository">
            
        
            <dir>
                
            
                <info compressed="false">https://cdn.jsdelivr.net/gh/sonvice/repository.sonvice@main/repo/addons.xml</info>
                
            
                <checksum>https://cdn.jsdelivr.net/gh/sonvice/repository.sonvice@main/repo/addons.xml.md5</checksum>
                
            
                <datadir zip="true">https://cdn.jsdelivr.net/gh/sonvice/repository.sonvice@main/repo/</datadir>
                
        
            </dir>
            
    
        </extension>
        

    </addon>
    <addon id="service.subtitles.opensubtitles-stremio" name="OpenSubtitles (Stremio v3)" version="1.0.0" provider-name="sonvice">
        
    
        <requires>
            
        
            <import addon="xbmc.python" version="3.0.0"/>
            
    
        </requires>
        
    
        <extension point="xbmc.subtitle.module" library="service.py"/>
        
    
        <extension point="xbmc.addon.metadata">
            
        
            <summary lang="en">OpenSubtitles v3 subtitle provider for Kodi</summary>
            
        
            <summary lang="es">Proveedor de subtítulos OpenSubtitles v3 para Kodi</summary>
            
        
            <description lang="en">Instant, high-speed subtitle search and downloads powered by OpenSubtitles v3. Completely free, requires no user account or API key, with native support for Spanish (Castellano/Latino) and English.</description>
            
        
            <description lang="es">Búsqueda y descarga instantánea de subtítulos mediante OpenSubtitles v3. Totalmente gratuito, no requiere registro ni claves de API, con soporte preferente para Español (Castellano/Latino) e Inglés.</description>
            
        
            <platform>all</platform>
            
        
            <license>MIT</license>
            
        
            <assets>
                
            
                <icon>icon.png</icon>
                
        
            </assets>
            
    
        </extension>
        

    </addon>
</addons>
